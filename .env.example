# Copy this file to `.env` and fill in your values.
#
# Path to the Twitter login cookie file you exported with the helper command.
# Keep this file OUTSIDE the repo — it logs you in. Treat it like a password.
TWITTER_COOKIE_FILE=~/.twitter_cookies.json

# Default currency label for the price you pass on the command line.
# Just a label — does no FX conversion.
DEFAULT_CURRENCY=USD

# How many recent original tweets to sample by default. Retweets are skipped.
DEFAULT_RECENT_N=20
